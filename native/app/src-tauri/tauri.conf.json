{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MachiningSim",
  "version": "0.1.0",
  "identifier": "com.machinigsim.native",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "切削シミュレーター (ネイティブ版)", "width": 1400, "height": 920, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "切削シミュレーター",
    "longDescription": "3 軸フライス加工のシミュレーションと、切りくず生成の有限要素解析 (2 次元 直交切削)"
  }
}
