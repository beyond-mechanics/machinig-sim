{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CuttingSim",
  "version": "0.1.0",
  "identifier": "local.machining.cuttingsim",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "切削シミュレーター（ネイティブ版・研究用の試作）",
        "width": 1440,
        "height": 960,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --ignore-gpu-blocklist"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "copyright": "研究用の試作。結果は参考値です。",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
